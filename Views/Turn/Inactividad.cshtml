@model caso_de_uso_6_ejercer_turno.Models.Domain.Player
@{
    ViewData["Title"] = "Inactividad";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    .warning-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .warning-card {
        background: white;
        border-radius: 24px;
        padding: 40px;
        max-width: 500px;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .timer-circle {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        font-size: 48px;
        font-weight: 700;
        color: white;
        box-shadow: 0 10px 25px rgba(251, 191, 36, 0.3);
        position: relative;
    }

        .timer-circle::after {
            content: 's';
            font-size: 20px;
            position: absolute;
            bottom: 30px;
            right: 35px;
        }

    .warning-title {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 12px;
    }
</style>

<div class="warning-page">
    <div class="warning-card">
        <div class="timer-circle">
            <span id="inactivity-timer">10</span>
        </div>
        <div class="warning-title">⏱️ Inactividad</div>
        <p class="success-text">
            Quedan <strong><span id="inactivity-timer-text">10</span> segundos</strong> para tirar el dado.
        </p>
        <p style="color: #64748b; margin-bottom: 20px;">
            Jugador: <strong>@(Model?.Nombre ?? "Jugador")</strong>
        </p>
        <div class="color-dots">
            <div class="color-dot" style="background: #ef4444;"></div>
            <div class="color-dot" style="background: #fbbf24;"></div>
            <div class="color-dot" style="background: #10b981;"></div>
            <div class="color-dot" style="background: #3b82f6;"></div>
        </div>
    </div>
</div>

<script>
    function startInactivityTimer(seconds, callback) {
        let remaining = seconds;
        const timerEl = document.getElementById('inactivity-timer');
        const timerTextEl = document.getElementById('inactivity-timer-text');

        const interval = setInterval(() => {
            remaining--;
            if (timerEl) timerEl.textContent = remaining;
            if (timerTextEl) timerTextEl.textContent = remaining;

            if (remaining <= 0) {
                clearInterval(interval);
                if (callback) callback();
            }
        }, 1000);
    }

    startInactivityTimer(10, function() {
        // lanzarDado();
        alert('Tiempo agotado - Lanzando dado automáticamente');
    });
</script>